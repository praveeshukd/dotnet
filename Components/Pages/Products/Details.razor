@page "/products/details/{Id:int}"
@rendermode InteractiveServer
@inject IProductService ProductService

<PageTitle>Product Details</PageTitle>

<h1>Product Details</h1>

@if (_notFound)
{
    <div class="alert alert-warning">Product not found.</div>
}
else if (_product is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@_product.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(_product.Description ?? "-")</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@(_product.Category?.Name ?? "-")</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@_product.Price.ToString("C")</dd>

        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@_product.Stock</dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@_product.CreatedAt.ToLocalTime().ToString("g")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(_product.IsActive ? "Active" : "Inactive")</dd>
    </dl>

    <a class="btn btn-primary" href="products/edit/@_product.Id">Edit</a>
}

<a class="btn btn-secondary" href="products">Back to list</a>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? _product;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        _product = await ProductService.GetProductAsync(Id);
        _notFound = _product is null;
    }
}
